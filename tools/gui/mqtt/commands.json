    {"id": "2004wled0", "name": "白光灯关", "expect": "1004", "payload": {"dataType": "2004", "action": "wled", "enable": 0}, "note": "即时 1004；异步 AT+WLED=0。同义 action=wled_off"},
    {"id": "2004wled1", "name": "白光灯开", "expect": "1004", "payload": {"dataType": "2004", "action": "wled", "enable": 1}, "note": "即时 1004；异步 AT+WLED=1。同义 action=wled_on"},

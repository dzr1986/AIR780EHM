    {"id": "2031", "name": "软光敏设置", "expect": "1031", "payload": {"dataType": "2031", "enable": 1, "nightModeThreshold": 500, "dayModeThreshold": 800, "dayModeAltThreshold": 600, "gbGainThreshold": 100, "gbGainRecordInit": 50, "checkTime": 10, "checkCount": 3}, "need_t3x": true}

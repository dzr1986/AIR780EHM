    {"id": "2010v", "name": "PIR 配置 video/auto", "expect": ["1010", "1004"], "timeout_sec": 45, "payload": {"dataType": "2010", "action": "video", "uploadMode": "auto", "quality": "high", "videoMaxDurationSec": 90, "stopOnSecondPir": 1, "stopOnCloud": 1}, "note": "即时 1004 pir_cfg + 1010 config_ok"},

    {"id": "2004off", "name": "关机", "expect": "1004", "allow_nonzero_ret": true, "payload": {"dataType": "2004", "action": "off"}, "skip_auto": true, "destructive": true, "note": "USB 插入时 1004 usb_block 不关机"},
    {"id": "2009fmt", "name": "TF 格式化 reboot=0", "expect": "1009", "timeout_sec": 45, "payload": {"dataType": "2009", "action": "format", "reboot": 0}, "need_t3x": true, "skip_auto": true, "tf_format": true, "allow_nonzero_ret": true, "note": "单独勾选「含 TF 格式化」才会跑。T3x 未就绪/无卡时 1009 ret=-1，不再吞应答"},
    {"id": "2004reboot", "name": "重启模组", "expect": "1004", "timeout_sec": 15, "payload": {"dataType": "2004", "action": "reboot"}, "skip_auto": true, "destructive": true, "note": "先 1004 reboot，约 0.8s 后复位；放最后测"},

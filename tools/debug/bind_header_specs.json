{
  "_comment": "host_uart cmd/ipc 子模块 bind 头真源；生成器对照/emit 用。延迟挂载字段用 wrapper，勿 local 快照。",
  "delayed_c_wrappers": [
    "parseIpcStat",
    "parseTfCard",
    "commitIpcStat",
    "patchCloud",
    "setRecActive",
    "hostQuery",
    "hostSet",
    "idCfg",
    "defineQuery",
    "defineSet"
  ],
  "modules": {
    "hif_cmd_usb.lua": {
      "bind_args": "C",
      "requires_sys": true,
      "requires_cfgm": false,
      "c": [
        "E",
        "rspOnly",
        "rspBody",
        "rspFmt",
        "rspLine",
        "rspLineOk",
        "modCall",
        "loader",
        "uart_bridge",
        "CRLF",
        "hostUsbCfg",
        "usbInserted",
        "t31xUartOff",
        "RSP_ERROR",
        "LOG_TAG",
        "pushUsbIdle"
      ]
    },
    "hif_cmd_link.lua": {
      "bind_args": "C",
      "requires_sys": true,
      "requires_cfgm": true,
      "c": ["state", "hooks", "E", "rspBody", "rspFmt", "rspLine", "okTail", "modCall", "utils", "RSP_ERROR", "parseSvcArgs"],
      "wrappers": [["qryGb28181", "C.M.qryGb28181"]]
    },
    "hif_cmd_pir.lua": {
      "bind_args": "C",
      "requires_sys": false,
      "c": ["state", "rspBody", "rspLineOk", "modCall", "getHostEvtPending"]
    },
    "hif_cmd_t31x.lua": {
      "bind_args": "C",
      "requires_sys": true,
      "c": ["state", "SYS_EVT", "E", "rspBody", "rspFmt", "rspLineOk", "modCall", "RSP_ERROR", "noteHostPush"],
      "wrappers": ["parseIpcStat", "parseTfCard", "commitIpcStat", "patchCloud", "setRecActive"]
    },
    "hif_cmd_wled.lua": {
      "bind_args": "C",
      "requires_sys": true,
      "requires_cfgm": true,
      "c": ["SYS_EVT", "rspFmt", "modCall", "utils", "hostNowMs", "t31xUartOff", "RSP_ERROR", "defineQuery", "defineSet", "TMO_SHARED"]
    },
    "hif_ipc_rec.lua": {
      "bind_args": "C, H",
      "requires_sys": true,
      "c": ["state", "SYS_EVT", "loader", "modCall", "usbInserted", "noopIdle", "pushUsbIdle", "TMO_SHARED", "enterSession", "leaveSession"],
      "h": ["getCfg", "hostQuery"]
    },
    "hif_ipc_hostq.lua": {
      "bind_args": "C, H",
      "requires_sys": true,
      "requires_cfgm": true,
      "c": ["state", "SYS_EVT", "utils"],
      "h": ["defineQuery", "defineSet"]
    },
    "hif_ipc_cloud.lua": {
      "bind_args": "C, H",
      "requires_sys": true,
      "c": ["state", "SYS_EVT", "E", "modCall", "hostBusy", "wledGet", "normIpcCloud", "commitIpcStat", "TMO_SHARED"],
      "h": ["getCfg", "hostQuery", "defineQuery", "idCfgFn", "qryHostStat", "qryHostRecord"]
    },
    "hif_ipc_power.lua": {
      "bind_args": "C, H",
      "requires_sys": true,
      "c": ["state", "SYS_EVT", "uartAcquire", "uartRelease", "waitHostIdle", "uart_bridge", "hostNowMs", "patchCloud", "TMO_SHARED", "enterSession", "leaveSession", "setRecActive"],
      "h": ["getCfg", "qryHostStat"]
    },
    "hif_ipc_tffmt.lua": {
      "bind_args": "C, H",
      "requires_sys": true,
      "requires_cfgm": true,
      "c": ["state", "SYS_EVT", "waitHostIdle", "uart_bridge", "utils", "t31xUartOff", "hostNowMs", "uartAcquire", "uartRelease", "TMO_SHARED", "enterSession", "leaveSession"],
      "h": ["ensT31xHost", "hostBoot"]
    },
    "hif_ipc_encode.lua": {
      "bind_args": "C, H",
      "requires_sys": false,
      "c": ["state", "SYS_EVT", "utils"],
      "h": ["hostQuery", "getCfg", "defineSet"]
    }
  }
}
